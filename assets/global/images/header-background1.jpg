<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="380" viewBox="0 0 1200 380">
  <!-- Background gradient -->
  <defs>
    <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#e8f0f7;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#0f4c81;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <rect width="1200" height="380" fill="url(#grad1)"/>
  
  <!-- Decorative elements -->
  <circle cx="150" cy="100" r="80" fill="rgba(255,255,255,0.1)"/>
  <circle cx="1050" cy="300" r="100" fill="rgba(255,255,255,0.08)"/>
  <rect x="400" y="150" width="400" height="2" fill="rgba(255,255,255,0.15)"/>
  
  <!-- Text placeholder -->
  <text x="600" y="190" font-family="Arial, sans-serif" font-size="42" fill="rgba(255,255,255,0.6)" text-anchor="middle" font-weight="bold">
    Agregar Imagen de Encabezado
  </text>
  <text x="600" y="230" font-family="Arial, sans-serif" font-size="16" fill="rgba(255,255,255,0.5)" text-anchor="middle">
    Reemplaza este archivo con tu imagen: static/images/header-background.jpg
  </text>
</svg>
