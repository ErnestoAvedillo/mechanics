msgstr "Initial stretched length (mm):"

#: muelles/static/muelles/js/calculadora-muelles.js:234
msgid "Longitud inicial (mm):"
msgstr "Initial length (mm):"

#: muelles/static/muelles/js/calculadora-muelles.js:238
msgid "Longitud final estirada (mm):"
msgstr "Final stretched length (mm):"

#: muelles/static/muelles/js/calculadora-muelles.js:238
msgid "Longitud final (mm):"
msgstr "Final length (mm):"

#: muelles/static/muelles/js/diameter-sync.js:64
msgid "Geometría bloqueada: selecciona material y diámetro de hilo"
msgstr "Geometry locked: select a material and wire diameter"

#: muelles/static/muelles/js/form_validation_compression.js:148
msgid "Pitch no válido"
msgstr "Invalid pitch"

#: muelles/static/muelles/js/form_validation_compression.js:148
msgid ""
"El pitch calculado es menor o igual al diámetro del hilo, lo que no es "
"físicamente posible. Por favor, revisa los datos ingresados."
msgstr ""
"The calculated pitch is less than or equal to the wire diameter, which is "
"not physically possible. Please review the entered data."

#: muelles/static/muelles/js/form_validation_compression.js:186
#: muelles/static/muelles/js/form_validation_compression.js:191
#: muelles/static/muelles/js/form_validation_compression.js:196
msgid "Longitud inicial no válida"
msgstr "Invalid initial length"

#: muelles/static/muelles/js/form_validation_compression.js:186
msgid ""
"La longitud inicial no puede ser mayor o igual a la longitud libre. Por "
"favor, revisa los datos ingresados."
msgstr ""
"The initial length cannot be greater than or equal to the free length. "
"Please review the entered data."

#: muelles/static/muelles/js/form_validation_compression.js:191
msgid ""
"La longitud inicial no puede ser menor o igual a la longitud sólida. Por "
"favor, revisa los datos ingresados."
msgstr ""
"The initial length cannot be less than or equal to the solid length. Please "
"review the entered data."

#: muelles/static/muelles/js/form_validation_compression.js:196
msgid ""
"La longitud inicial no puede ser mayor o igual a la longitud final. Por "
"favor, revisa los datos ingresados."
msgstr ""
"The initial length cannot be greater than or equal to the final length. "
"Please review the entered data."

#: muelles/static/muelles/js/form_validation_compression.js:203
#: muelles/static/muelles/js/form_validation_compression.js:208
#: muelles/static/muelles/js/form_validation_compression.js:213
msgid "Longitud final no válida"
msgstr "Invalid final length"

#: muelles/static/muelles/js/form_validation_compression.js:203
msgid ""
"La longitud final no puede ser mayor o igual a la longitud libre. Por favor, "
"revisa los datos ingresados."
msgstr ""
"The final length cannot be greater than or equal to the free length. Please "
"review the entered data."

#: muelles/static/muelles/js/form_validation_compression.js:208
msgid ""
"La longitud final no puede ser menor o igual a la longitud sólida. Por "
"favor, revisa los datos ingresados."
msgstr ""
"The final length cannot be less than or equal to the solid length. Please "
"review the entered data."

#: muelles/static/muelles/js/form_validation_compression.js:213
msgid ""
"La longitud final no puede ser menor o igual a la longitud inicial. Por "
"favor, revisa los datos ingresados."
msgstr ""
"The final length cannot be less than or equal to the initial length. Please "
"review the entered data."

#: muelles/static/muelles/js/form_validation_compression.js:235
msgid "Material no seleccionado"
msgstr "Material not selected"

#: muelles/static/muelles/js/form_validation_compression.js:235
msgid "Debes seleccionar un material antes de calcular."
msgstr "You must select a material before calculating."

