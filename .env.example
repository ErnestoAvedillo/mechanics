# Copy this file to .env and replace every CHANGE_ME. Never commit .env.
#   cp .env.example .env

# --- Django -----------------------------------------------------------------
DJANGO_SECRET_KEY=CHANGE_ME_to_a_long_random_string
# True: development server, and the sign-up verification codes are printed in the django logs
# (docker compose logs django), so no email server is needed. False: gunicorn + real SMTP.
DJANGO_DEBUG=True
PYTHONUNBUFFERED=1
DJANGO_SETTINGS_MODULE=src.mechanics.settings
PYTHONPATH=/app:/app/src

# --- Nebius Token Factory (LLM and embeddings, required) ---------------------
# Create a key at https://tokenfactory.nebius.com
NEBIUS_API_KEY=CHANGE_ME
# Optional overrides (these are the defaults):
# NEBIUS_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
# NEBIUS_EMBED_MODEL=Qwen/Qwen3-Embedding-8B
# NEBIUS_VISION_MODEL=Qwen/Qwen2.5-VL-72B-Instruct

# --- Privacy policy (data controller shown on /privacy/) ---------------------
LEGAL_NAME=Ernesto Avedillo
# NIF and postal address of the controller (required by the LSSI for the legal notice)
LEGAL_ID=
LEGAL_ADDRESS=
PRIVACY_CONTACT_EMAIL=eavedillo@yahoo.es

# Maximum documents each user can keep in their library (0 = no limit)
MAX_DOCUMENTS_PER_USER=20

# --- LlamaParse (PDF parsing with OCR, required for scanned PDFs) ------------
# Free key at https://cloud.llamaindex.ai
LLAMA_CLOUD_API_KEY=CHANGE_ME

# --- Qdrant (vector database, runs in the compose stack) ---------------------
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=mechanics
POSTGRES_USER=mechanics
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- MongoDB (stores the uploaded PDFs) and its web console ------------------
MONGO_INITDB_DATABASE=mechanics
MONGO_INITDB_ROOT_USERNAME=mongoadmin
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_EXPRESS_PORT=8081
ME_CONFIG_MONGODB_SERVER=$MONGO_HOST
ME_CONFIG_MONGODB_PORT=$MONGO_PORT
ME_CONFIG_MONGODB_ADMINUSERNAME=mongoadmin
# Must match MONGO_INITDB_ROOT_PASSWORD
ME_CONFIG_MONGODB_ADMINPASSWORD=CHANGE_ME
ME_CONFIG_MONGODB_AUTH_DATABASE=admin
ME_CONFIG_MONGODB_URL=mongodb://mongoadmin:CHANGE_ME@mongodb:27017/mechanics
ME_CONFIG_MONGODB_ENABLE_ADMIN=true

# --- Email (only used when DJANGO_DEBUG=False) -------------------------------
# Gmail needs an app password. Port 587 uses STARTTLS and 465 uses SSL; many hosting providers block
# outbound 465 (and 25), so 587 is the safe default.
NO_REPLY_EMAIL=no-reply@example.com
NO_REPLY_PASSWORD=CHANGE_ME
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# --- reCAPTCHA (optional, only for the share-by-email form of the calculators)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
